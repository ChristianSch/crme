HTTP_ADDR=:8080
# Use a least-privilege non-owner app role in production; see docs/database-roles.md.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crme?sslmode=disable
APP_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:3000
# Comma-separated extra browser origins allowed to make mutating API requests.
# Default includes the bundled Chrome LinkedIn extension origin.
CRME_ALLOWED_ORIGINS=chrome-extension://kkfpdeggkbniiaajibbejcfcicbbilmn
APP_ENV=dev
MAGIC_LINK_SECRET=dev-secret-change-me
# Required for the first login; this active owner user is created on first magic-link request.
BOOTSTRAP_OWNER_EMAIL=you@example.com
# 32 random bytes, base64 encoded. Generate with: openssl rand -base64 32
CRME_SECRET_KEY=
SMTP_FROM=no-reply@example.local
# Required in production for magic-link email delivery via Resend.
RESEND_API_KEY=
RESEND_DOMAIN=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional background IMAP sync interval, e.g. 5m. Leave empty for manual sync only.
EMAIL_SYNC_INTERVAL=
# Cleanup interval for expired magic links and old sessions. Set empty to disable.
HOUSEKEEPING_INTERVAL=1h
# Logging: LOG_LEVEL=debug|info|warn|error, LOG_FORMAT=text|json
LOG_LEVEL=info
LOG_FORMAT=text
